# ==============================================================================
# MY POS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONEKSI SUPABASE CLOUD (Rekomendasi untuk Vercel & POS Toko Online)
# ------------------------------------------------------------------------------
# - DATABASE_URL: Menggunakan Transaction Mode Pooler (Port 6543) dengan ?pgbouncer=true&sslmode=require&uselibpqcompat=true
# - DIRECT_URL: Menggunakan Session Mode Pooler (Port 5432) untuk migrasi DDL schema
# Catatan: Gunakan host pooler (misal: aws-1-ap-southeast-2.pooler.supabase.com) untuk koneksi IPv4 publik yang stabil.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# ------------------------------------------------------------------------------
# 2. OPSI KONEKSI POSTGRESQL LOKAL (Offline Total di Komputer Toko)
# ------------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/my_pos"
# DIRECT_URL="postgresql://postgres:password@127.0.0.1:5432/my_pos"

# ------------------------------------------------------------------------------
# 3. KUNCI RAHASIA AUTENTIKASI (Wajib minimal 32 karakter acak)
# ------------------------------------------------------------------------------
AUTH_SECRET="mypos-super-secure-auth-secret-key-2026-min-32-chars"
